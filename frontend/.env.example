# Copia este archivo a .env.local si necesitas cambiar algo (no se sube a Git).

# URL base de la API. Déjala vacía para usar "/api" en el mismo origen:
#  - en desarrollo, Vite redirige /api a BACKEND_URL (proxy)
#  - en producción, Laravel sirve la web y la API juntas
VITE_API_URL=

# Adónde redirige el proxy de Vite las llamadas a /api durante `npm run dev`.
BACKEND_URL=http://127.0.0.1:8000

# true  = modo sin servidor: usa respuestas guardadas (solo los ejemplos de «Cargar ejemplo»)
# false = llama a la API real de Laravel
VITE_USE_MOCK=false

# Latencia simulada del modo sin servidor en ms (para ver el estado de carga)
VITE_MOCK_DELAY_MS=600
